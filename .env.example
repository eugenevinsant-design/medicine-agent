# ===== LLM провайдер =====
# Основной: OpenRouter (модель с function calling)
# Fallback: Groq
# Переключение: измени LLM_API_BASE_URL и LLM_API_KEY

# --- OpenRouter (primary) ---
LLM_API_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxx
LLM_MODEL=openai/gpt-oss-20b:free

# --- Groq (fallback) ---
# LLM_API_BASE_URL=https://api.groq.com/openai/v1
# LLM_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxx
# LLM_MODEL=openai/gpt-oss-20b

# ===== Qdrant =====
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=medical_knowledge

# ===== Эмбеддинги (FastEmbed, локально, без GPU) =====
# Должна совпадать с RAG_EMBEDDING_MODEL Open WebUI (иначе векторы несовместимы)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384

# ===== SearxNG =====
# Для скриптов с хоста: http://localhost:8080
# Для Tool внутри Open WebUI (контейнер): http://searxng:8080 (задаётся в docker-compose.yml)
SEARXNG_URL=http://localhost:8080

# ===== Eval (run_eval.py) =====
# stub — без LLM (детерминированные ответы); openwebui — реальный вызов
EVAL_MODE=stub
OPENWEBUI_BASE_URL=http://localhost:3000
OPENWEBUI_API_PATH=/api/chat/completions
OPENWEBUI_API_KEY=
OPENWEBUI_MODEL=

# ===== ФЗ-152 =====
# Ключ шифрования mapping-таблицы (Fernet). Сгенерируй: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ID_MAP_FERNET_KEY=change-me-generate-your-own-key
